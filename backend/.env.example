# Local (non-Docker) backend environment variables.
# Copy to backend/.env for `npm run dev`.
PORT=5000

# MongoDB Atlas connection string. Get this from the Atlas dashboard
# under "Connect" -> "Drivers". See the root README.md for full setup
# instructions (cluster, database user, network access).
MONGODB_URI=your_mongodb_atlas_connection_string

ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
