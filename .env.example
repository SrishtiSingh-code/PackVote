# =============================================================================
# PackVote — Environment Variables
# Copy this file to .env in the project root before running
# `docker compose up --build`
# =============================================================================

# MongoDB Atlas connection string used by the backend to connect to your
# cloud-hosted MongoDB cluster. Get this from the Atlas dashboard under
# "Connect" -> "Drivers" for your cluster. See the "MongoDB Atlas setup"
# section in README.md for the full step-by-step walkthrough.
#
# Example shape (do NOT commit your real value):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/packvote?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# Port the backend Express server listens on.
PORT=5000

# The base URL the frontend uses to call the backend API.
# When running via Docker Compose on your own machine, keep this as-is.
VITE_API_URL=http://localhost:5000/api

# Anthropic API key used to generate the natural-language trip summary.
# Optional: if left blank, the backend falls back to a simple local
# template so the app still works end-to-end without any AI key.
ANTHROPIC_API_KEY=

# Which model to call for the AI summary.
AI_MODEL=claude-sonnet-4-5
